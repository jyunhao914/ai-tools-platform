{
  "manifestVersion": 5,
  "id": "com.aitoolsplatform.chatvideopro",
  "name": "Chat Video Pro Lite",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "chatVideoProPanel",
      "label": {
        "default": "Chat Video Pro Lite"
      },
      "minimumSize": { "width": 360, "height": 480 },
      "preferredDockedSize": { "width": 420, "height": 720 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
          "species": ["chrome"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "https://api.anthropic.com",
        "https://api.openai.com"
      ]
    },
    "clipboard": "readAndWrite"
  }
}
